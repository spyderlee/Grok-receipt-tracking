# Maid Receipt Bot configuration.
# Production (bot-deploy): Albert writes /etc/bots/maid-receipt/env as root:root 0600 via the
# hidden-input secrets script. Never commit the real file.
# NOTE: systemd EnvironmentFile does not support trailing comments - keep
# comments on their own lines and don't quote values.
#
# The unit already sets MYSQL_UNIX_SOCKET / MYSQL_USER / MYSQL_DATABASE / RECEIPT_PHOTO_DIR /
# BOT_LOCK_FILE. This file only needs the secrets and Telegram IDs.

# ---- Required -------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-BotFather
# Albert's numeric Telegram user id
ADMIN_TELEGRAM_ID=111111111
# the maid's numeric Telegram user id
MAID_TELEGRAM_ID=222222222

# ---- Database (socket auth — default on the office server) ----------
# Unit already sets these; listed here for local runs without the unit.
MYSQL_UNIX_SOCKET=/run/mysqld/mysqld.sock
MYSQL_USER=bot-maid-receipt
MYSQL_DATABASE=bot_maid_receipt
# MYSQL_PASSWORD is NOT used with unix_socket auth (leave unset / empty).
# Password auth fallback (local tests or if the socket plugin is unavailable):
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_PASSWORD=at-least-12-characters

# ---- Optional (defaults shown) --------------------------------------
# 0-100; below this (or no amount found) -> vision fallback
OCR_CONFIDENCE_THRESHOLD=70
# e.g. eng+chi_tra after: apt install tesseract-ocr-chi-tra
OCR_LANG=eng

# empty = vision fallback disabled (Tesseract only)
VISION_API_KEY=
# low-cost tier, NOT the flagship model
VISION_MODEL=gpt-4o-mini
# any OpenAI-compatible /chat/completions API
VISION_API_BASE_URL=https://api.openai.com/v1
VISION_TIMEOUT_SECONDS=60

# HKD; alert Albert when balance <= this (max once per day)
LOW_FLOAT_THRESHOLD=100
# no background (hourly-sweep) re-send of an undelivered low-float alert in these hours; "off" disables
LOW_ALERT_QUIET_HOURS=22-8
# Unit sets these; override only for local runs
# RECEIPT_PHOTO_DIR=/var/lib/bots/maid-receipt/photos
# BOT_LOCK_FILE=/var/lib/bots/maid-receipt/bot.lock
BOT_TIMEZONE=Asia/Hong_Kong
ADMIN_DISPLAY_NAME=Albert
LOG_LEVEL=INFO
